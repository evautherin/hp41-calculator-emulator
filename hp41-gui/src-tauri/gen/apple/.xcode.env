# Portable PATH additions for the Xcode "Build Rust Code" phase (P-iOS-09).
# Xcode (GUI) does not inherit the interactive shell PATH; cargo lives in
# $HOME/.cargo/bin which Xcode does not know about. This file is committed and
# uses only $HOME-relative paths so it works for any developer / CI runner.
# Machine-specific paths (e.g. an nvm-managed node bin) belong in the gitignored
# .xcode.env.local instead.
export PATH="$HOME/.cargo/bin:$PATH"
